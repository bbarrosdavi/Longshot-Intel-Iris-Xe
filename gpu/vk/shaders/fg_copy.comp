#version 450
// Frame generation (vk_framegen.cpp): fused game-frame crop copy + optional dual-write to OutSet game slot
// + optional 4x4 quarter-size luma downsample via SLM (replaces separate fg_luma + vkCmdCopyImage + 2 full barriers).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(binding = 2, rgba8) uniform writeonly image2D dst_game;
layout(binding = 3, r16f) uniform writeonly image2D dst_luma;
layout(push_constant) uniform P { ivec2 offset; ivec2 size; int write_game; int write_luma; } pc;
shared float s_luma[8][8];
void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 lid = ivec2(gl_LocalInvocationID.xy);
    const bool in_bounds = all(lessThan(g, pc.size));
    const ivec2 clamped = min(g, pc.size - 1);
    const vec3 c = (in_bounds || pc.write_luma != 0) ? texelFetch(src, clamped + pc.offset, 0).rgb : vec3(0.0);
    if (in_bounds) {
        imageStore(dst, g, vec4(c, 1.0));
        if (pc.write_game != 0) imageStore(dst_game, g, vec4(c, 1.0));
    }
    if (pc.write_luma != 0) {
        s_luma[lid.y][lid.x] = dot(c, vec3(0.299, 0.587, 0.114));
        barrier();
        if (lid.x < 2 && lid.y < 2) {
            const ivec2 q = ivec2(gl_WorkGroupID.xy) * 2 + lid;
            if (all(lessThan(q, imageSize(dst_luma)))) {
                const int bx = lid.x * 4, by = lid.y * 4;
                float sum = 0.0;
                for (int y = 0; y < 4; y++)
                    for (int x = 0; x < 4; x++)
                        sum += s_luma[by + y][bx + x];
                imageStore(dst_luma, q, vec4(sum * 0.0625));
            }
        }
    }
}
