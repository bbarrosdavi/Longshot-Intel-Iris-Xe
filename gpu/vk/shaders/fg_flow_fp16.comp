#version 450
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// (Batch 11A) FP16 SLM tile caching (36x36 la + 60x60 lb = 9.6 KB SLM, 2x Gen12 occupancy, lossless vs r16f inputs)
// + packed f16vec4 SADs + 3x3 fine SAD cache reuse for parabolic subpixel refinement (4 fewer sad64 calls).
layout(local_size_x = 8, local_size_y = 8) in;
layout(constant_id = 0) const int RADIUS = 12;
layout(binding = 0) uniform sampler2D la;
layout(binding = 1) uniform sampler2D lb;
layout(binding = 2, rgba16f) uniform writeonly image2D flow;

shared float16_t s_la[36][36];
shared float16_t s_lb[60][60];

float sad64_slm(int ax, int ay, int bx, int by) {
    f16vec4 acc = f16vec4(0.0hf);
    [[dont_unroll]] for (int py = 0; py < 8; py++) {
        const int lay = ay + py;
        const int lby = by + py;
        const f16vec4 a0 = f16vec4(s_la[lay][ax + 0], s_la[lay][ax + 1], s_la[lay][ax + 2], s_la[lay][ax + 3]);
        const f16vec4 b0 = f16vec4(s_lb[lby][bx + 0], s_lb[lby][bx + 1], s_lb[lby][bx + 2], s_lb[lby][bx + 3]);
        const f16vec4 a1 = f16vec4(s_la[lay][ax + 4], s_la[lay][ax + 5], s_la[lay][ax + 6], s_la[lay][ax + 7]);
        const f16vec4 b1 = f16vec4(s_lb[lby][bx + 4], s_lb[lby][bx + 5], s_lb[lby][bx + 6], s_lb[lby][bx + 7]);
        acc += abs(a0 - b0) + abs(a1 - b1);
    }
    return float(acc.x + acc.y + acc.z + acc.w);
}

void main() {
    const ivec2 wg = ivec2(gl_WorkGroupID.xy);
    const ivec2 lid = ivec2(gl_LocalInvocationID.xy);
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 fsize = imageSize(flow);
    const ivec2 lm = textureSize(la, 0) - 1;

    if (RADIUS <= 12) {
        const int lidx = int(gl_LocalInvocationIndex);
        const ivec2 la_orig = wg * 32 - 2;
        for (int idx = lidx; idx < 36 * 36; idx += 64) {
            const int y = idx / 36;
            const int x = idx - y * 36;
            s_la[y][x] = float16_t(texelFetch(la, clamp(la_orig + ivec2(x, y), ivec2(0), lm), 0).r);
        }
        const ivec2 lb_orig = wg * 32 - 14;
        for (int idx = lidx; idx < 60 * 60; idx += 64) {
            const int y = idx / 60;
            const int x = idx - y * 60;
            s_lb[y][x] = float16_t(texelFetch(lb, clamp(lb_orig + ivec2(x, y), ivec2(0), lm), 0).r);
        }
        barrier();
        if (any(greaterThanEqual(g, fsize))) return;

        const int ax = lid.x * 4;
        const int ay = lid.y * 4;
        const int bx = ax + 12;
        const int by = ay + 12;

        const f16vec4 p0 = f16vec4(s_la[ay + 0][ax + 0], s_la[ay + 0][ax + 2], s_la[ay + 0][ax + 5], s_la[ay + 0][ax + 7]);
        const f16vec4 p1 = f16vec4(s_la[ay + 2][ax + 0], s_la[ay + 2][ax + 2], s_la[ay + 2][ax + 5], s_la[ay + 2][ax + 7]);
        const f16vec4 p2 = f16vec4(s_la[ay + 5][ax + 0], s_la[ay + 5][ax + 2], s_la[ay + 5][ax + 5], s_la[ay + 5][ax + 7]);
        const f16vec4 p3 = f16vec4(s_la[ay + 7][ax + 0], s_la[ay + 7][ax + 2], s_la[ay + 7][ax + 5], s_la[ay + 7][ax + 7]);

        float cbest = 1e9, cbest2 = 1e9;
        ivec2 cv = ivec2(0), cv2 = ivec2(0);
        for (int dy = -RADIUS; dy <= RADIUS; dy += 2) {
            const int r0 = by + dy;
            const int r1 = r0 + 2;
            const int r2 = r0 + 5;
            const int r3 = r0 + 7;
            for (int dx = -RADIUS; dx <= RADIUS; dx += 2) {
                const int c0 = bx + dx;
                const int c1 = c0 + 2;
                const int c2 = c0 + 5;
                const int c3 = c0 + 7;
                const f16vec4 d =
                    abs(p0 - f16vec4(s_lb[r0][c0], s_lb[r0][c1], s_lb[r0][c2], s_lb[r0][c3])) +
                    abs(p1 - f16vec4(s_lb[r1][c0], s_lb[r1][c1], s_lb[r1][c2], s_lb[r1][c3])) +
                    abs(p2 - f16vec4(s_lb[r2][c0], s_lb[r2][c1], s_lb[r2][c2], s_lb[r2][c3])) +
                    abs(p3 - f16vec4(s_lb[r3][c0], s_lb[r3][c1], s_lb[r3][c2], s_lb[r3][c3]));
                const float s = float((d.x + d.y) + (d.z + d.w));
                const float cost = s * 4.0 + 0.12 * float(abs(dx) + abs(dy)) + (dx != 0 || dy != 0 ? 0.6 : 0.0);
                if (cost < cbest) {
                    cbest2 = cbest; cv2 = cv;
                    cbest = cost; cv = ivec2(dx, dy);
                } else if (cost < cbest2) {
                    cbest2 = cost; cv2 = ivec2(dx, dy);
                }
            }
        }

        // Stage 2: exact 64-sample SAD at (0,0), 3x3 around best coarse candidate (cached for parabolic fit), and secondary candidate
        const float sad0 = sad64_slm(ax, ay, bx, by);
        float best_sad = sad0;
        float best = sad0;
        ivec2 bv = ivec2(0);
        float g3[9];
        for (int j = -1; j <= 1; j++) {
            const int dy = cv.y + j;
            for (int i = -1; i <= 1; i++) {
                const int dx = cv.x + i;
                float sad;
                if (dx < -RADIUS || dx > RADIUS || dy < -RADIUS || dy > RADIUS) {
                    sad = 1e9;
                } else if (dx == 0 && dy == 0) {
                    sad = sad0;
                } else {
                    sad = sad64_slm(ax, ay, bx + dx, by + dy);
                    const float cost = sad + 0.12 * float(abs(dx) + abs(dy)) + 0.6;
                    if (cost < best) { best = cost; best_sad = sad; bv = ivec2(dx, dy); }
                }
                g3[(j + 1) * 3 + (i + 1)] = sad;
            }
        }
        bool from_cv2 = false;
        if (abs(cv2.x - cv.x) > 1 || abs(cv2.y - cv.y) > 1) {
            if (cv2.x != 0 || cv2.y != 0) {
                const float sad = sad64_slm(ax, ay, bx + cv2.x, by + cv2.y);
                const float cost = sad + 0.12 * float(abs(cv2.x) + abs(cv2.y)) + 0.6;
                if (cost < best) { best = cost; best_sad = sad; bv = cv2; from_cv2 = true; }
            }
        }

        // Parabolic subpixel refinement reusing cached 3x3 SADs whenever neighbors lie inside the 3x3 box around cv
        vec2 sub = vec2(0.0);
        if (bv.x != 0 || bv.y != 0) {
            const ivec2 rel = bv - cv;
            if (bv.x > -RADIUS && bv.x < RADIUS) {
                const float sL = (!from_cv2 && rel.x - 1 >= -1 && rel.x - 1 <= 1 && rel.y >= -1 && rel.y <= 1)
                                     ? g3[(rel.y + 1) * 3 + (rel.x)]
                                     : sad64_slm(ax, ay, bx + bv.x - 1, by + bv.y);
                const float sR = (!from_cv2 && rel.x + 1 >= -1 && rel.x + 1 <= 1 && rel.y >= -1 && rel.y <= 1)
                                     ? g3[(rel.y + 1) * 3 + (rel.x + 2)]
                                     : sad64_slm(ax, ay, bx + bv.x + 1, by + bv.y);
                const float den = 2.0 * (sL - 2.0 * best_sad + sR);
                if (best_sad <= sL && best_sad <= sR && den > 1e-4) sub.x = clamp((sL - sR) / den, -0.5, 0.5);
            }
            if (bv.y > -RADIUS && bv.y < RADIUS) {
                const float sU = (!from_cv2 && rel.x >= -1 && rel.x <= 1 && rel.y - 1 >= -1 && rel.y - 1 <= 1)
                                     ? g3[(rel.y) * 3 + (rel.x + 1)]
                                     : sad64_slm(ax, ay, bx + bv.x, by + bv.y - 1);
                const float sD = (!from_cv2 && rel.x >= -1 && rel.x <= 1 && rel.y + 1 >= -1 && rel.y + 1 <= 1)
                                     ? g3[(rel.y + 2) * 3 + (rel.x + 1)]
                                     : sad64_slm(ax, ay, bx + bv.x, by + bv.y + 1);
                const float den = 2.0 * (sU - 2.0 * best_sad + sD);
                if (best_sad <= sU && best_sad <= sD && den > 1e-4) sub.y = clamp((sU - sD) / den, -0.5, 0.5);
            }
        }
        imageStore(flow, g, vec4((vec2(bv) + sub) * 4.0, best / 64.0, 1.0));
        return;
    }

    if (any(greaterThanEqual(g, fsize))) return;
    const ivec2 c = g * 4 + 2;
    const int offs[4] = int[4](-4, -2, 1, 3);
    float pa16[16];
    for (int j = 0; j < 4; j++)
        for (int i = 0; i < 4; i++)
            pa16[j * 4 + i] = texelFetch(la, clamp(c + ivec2(offs[i], offs[j]), ivec2(0), lm), 0).r;
    float cbest = 1e9;
    ivec2 cv = ivec2(0);
    for (int dy = -RADIUS; dy <= RADIUS; dy += 2) {
        for (int dx = -RADIUS; dx <= RADIUS; dx += 2) {
            float s = 0.0;
            for (int j = 0; j < 4; j++)
                for (int i = 0; i < 4; i++)
                    s += abs(pa16[j * 4 + i] - texelFetch(lb, clamp(c + ivec2(offs[i] + dx, offs[j] + dy), ivec2(0), lm), 0).r);
            const float cost = s * 4.0 + 0.12 * float(abs(dx) + abs(dy)) + (dx != 0 || dy != 0 ? 0.6 : 0.0);
            if (cost < cbest) cbest = cost, cv = ivec2(dx, dy);
        }
    }
    float best = 1e9;
    ivec2 bv = ivec2(0);
    for (int dy = max(-RADIUS, cv.y - 1); dy <= min(RADIUS, cv.y + 1); dy++) {
        for (int dx = max(-RADIUS, cv.x - 1); dx <= min(RADIUS, cv.x + 1); dx++) {
            float sad = 0.0;
            for (int py = -4; py < 4; py++)
                for (int px = -4; px < 4; px++)
                    sad += abs(texelFetch(la, clamp(c + ivec2(px, py), ivec2(0), lm), 0).r -
                               texelFetch(lb, clamp(c + ivec2(px + dx, py + dy), ivec2(0), lm), 0).r);
            const float cost = sad + 0.12 * float(abs(dx) + abs(dy)) + (dx != 0 || dy != 0 ? 0.6 : 0.0);
            if (cost < best) best = cost, bv = ivec2(dx, dy);
        }
    }
    imageStore(flow, g, vec4(vec2(bv) * 4.0, best / 64.0, 1.0));
}
