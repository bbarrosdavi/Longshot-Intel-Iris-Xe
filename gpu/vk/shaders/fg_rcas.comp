#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P { float sharp; } pc;
const float16_t kMaxLobe = float16_t(0.25 - 1.0 / 16.0);
void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 d = imageSize(dst);
    if (any(greaterThanEqual(g, d))) return;
    const ivec2 dm = d - 1;
    const f16vec3 c = f16vec3(texelFetch(src, g, 0).rgb);
    const f16vec3 n = f16vec3(texelFetch(src, ivec2(g.x, max(g.y - 1, 0)), 0).rgb);
    const f16vec3 s = f16vec3(texelFetch(src, ivec2(g.x, min(g.y + 1, dm.y)), 0).rgb);
    const f16vec3 w = f16vec3(texelFetch(src, ivec2(max(g.x - 1, 0), g.y), 0).rgb);
    const f16vec3 e = f16vec3(texelFetch(src, ivec2(min(g.x + 1, dm.x), g.y), 0).rgb);
    const f16vec3 lo4 = min(min(n, s), min(w, e));
    const f16vec3 hi4 = max(max(n, s), max(w, e));
    const f16vec3 lo = min(lo4, c);
    const f16vec3 hi = max(hi4, c);
    const f16vec3 to_black = lo / max(float16_t(4.0) * hi, f16vec3(1.0hf / 1024.0hf));
    const f16vec3 to_white = (f16vec3(1.0hf) - hi) / max(f16vec3(4.0hf) - float16_t(4.0) * lo4, f16vec3(1.0hf / 1024.0hf));
    const f16vec3 room = min(to_black, to_white);
    const float16_t lobe = -clamp(min(min(room.r, room.g), room.b), 0.0hf, kMaxLobe) * float16_t(clamp(pc.sharp, 0.0, 1.0));
    const f16vec3 res = clamp((c + lobe * (n + s + w + e)) / (1.0hf + float16_t(4.0) * lobe), lo, hi);
    imageStore(dst, g, vec4(vec3(res), 1.0));
}
