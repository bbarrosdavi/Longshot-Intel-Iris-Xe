#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// (Batch 11A) Dedicated 1:1 RCAS sharpening pass (mode==0, side==0, src==dst size, !pq).
// Exact same math as fg_scale.comp::sharpen(), using a 10x10 cooperative f16vec3 SLM tile (3.2x fewer texture reads, ~20x smaller ISA).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P { float sharp; } pc;
const float16_t kMaxLobe = float16_t(0.25 - 1.0 / 16.0);
shared f16vec3 s_tile[10][10];
void main() {
    const ivec2 wg = ivec2(gl_WorkGroupID.xy);
    const ivec2 lid = ivec2(gl_LocalInvocationID.xy);
    const ivec2 d = imageSize(dst);
    const ivec2 dm = d - 1;
    const ivec2 base = wg * 8 - 1;
    const int lidx = int(gl_LocalInvocationIndex);
    for (int idx = lidx; idx < 100; idx += 64) {
        const int ty = idx / 10;
        const int tx = idx - ty * 10;
        s_tile[ty][tx] = f16vec3(texelFetch(src, clamp(base + ivec2(tx, ty), ivec2(0), dm), 0).rgb);
    }
    barrier();
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(g, d))) return;
    const int x = lid.x + 1;
    const int y = lid.y + 1;
    const f16vec3 c = s_tile[y][x];
    const f16vec3 n = s_tile[y - 1][x];
    const f16vec3 s = s_tile[y + 1][x];
    const f16vec3 w = s_tile[y][x - 1];
    const f16vec3 e = s_tile[y][x + 1];
    const f16vec3 lo4 = min(min(n, s), min(w, e));
    const f16vec3 hi4 = max(max(n, s), max(w, e));
    const f16vec3 lo = min(lo4, c);
    const f16vec3 hi = max(hi4, c);
    const f16vec3 to_black = lo / max(float16_t(4.0) * hi, f16vec3(1.0hf / 1024.0hf));
    const f16vec3 to_white = (f16vec3(1.0hf) - hi) / max(f16vec3(4.0hf) - float16_t(4.0) * lo4, f16vec3(1.0hf / 1024.0hf));
    const f16vec3 room = min(to_black, to_white);
    const float16_t lobe = -clamp(min(min(room.r, room.g), room.b), 0.0hf, kMaxLobe) * float16_t(clamp(pc.sharp, 0.0, 1.0));
    const f16vec3 res = clamp((c + lobe * (n + s + w + e)) / (1.0hf + float16_t(4.0) * lobe), lo, hi);
    imageStore(dst, g, vec4(vec3(res), 1.0));
}
