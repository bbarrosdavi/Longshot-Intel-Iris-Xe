#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// (Batch 12B) Fused game-frame crop copy + direct game-slot write + HUD alpha mask into fg.frames[cur].a.
// Alpha = 0.0 marks HUD pixels (opaque, semi-transparent, or animated), 1.0 marks clean 3D scene pixels:
//   - hud_mode bit 0 (1): exact before/after diff against temporal upscale output (s.output vs out after HUD);
//     bit 2 (4): square s.output before comparing (matches dlss_out.comp kSquare=true for SDR).
//   - hud_mode bit 1 (2): motion-contradiction HUD fallback (dlss=0): static pixel where 3D MV > 4 px.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1) uniform sampler2D aux0;   // mode 1: s.output (before HUD); mode 2: prev fg.frame
layout(binding = 2) uniform sampler2D aux1;   // mode 1: out picture (after HUD); mode 2: mv_tex
layout(binding = 3, rgba8) uniform writeonly image2D dst;
layout(binding = 4, rgba8) uniform writeonly image2D dst_game;
layout(push_constant) uniform P {
    ivec2 offset;
    ivec2 size;
    int write_game;
    int hud_mode;
    vec2 uv_scale;
    vec2 uv_max;
    vec2 mv_scale;
} pc;

void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(g, pc.size))) return;
    const ivec2 q = g + pc.offset;
    const f16vec3 c = f16vec3(texelFetch(src, q, 0).rgb);
    if (pc.write_game != 0) imageStore(dst_game, g, vec4(vec3(c), 1.0));
    bool is_hud = false;
    if ((pc.hud_mode & 1) != 0) {
        vec3 before = max(texelFetch(aux0, q, 0).rgb, vec3(0.0));
        if ((pc.hud_mode & 4) != 0) before *= before;
        const vec3 after = texelFetch(aux1, q, 0).rgb;
        // B10G11R11 quantization tolerance: R11/G11 have 6-bit mantissa (~0.8%), B10 has 5-bit (~1.6%).
        const vec3 tol = max(vec3(0.004), before * vec3(0.016, 0.016, 0.032));
        is_hud = any(greaterThan(abs(before - after), tol));
    } else if ((pc.hud_mode & 2) != 0) {
        const f16vec3 prev = f16vec3(texelFetch(aux0, g, 0).rgb);
        const f16vec3 d = abs(c - prev);
        if (max(d.r, max(d.g, d.b)) < 0.03hf) {
            const vec2 uv = clamp((vec2(g) + 0.5) / vec2(pc.size) * pc.uv_scale, vec2(0.0), pc.uv_max);
            const vec2 v = textureLod(aux1, uv, 0.0).xy * pc.mv_scale;
            is_hud = dot(v, v) > 16.0;
        }
    }
    imageStore(dst, g, vec4(vec3(c), is_hud ? 0.0 : 1.0));
}
