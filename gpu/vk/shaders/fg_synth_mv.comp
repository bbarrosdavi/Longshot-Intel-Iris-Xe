#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// (Batch 14) Zero-shear, zero-lag, spike-free FP16 single-output 3D Motion-Vector synthesis (2x / Auto / >3x FG).
// - Converges moving silhouettes via 2-step fixed-point lookup, accepting the foreground candidate ONLY when
//   warped (fa, fb) actually agree (eliminating edge spikes pulled into sky/background).
// - On disocclusions or sharp RCAS/FSR3 differences, resolves to frame B's warped surface (b4) using the
//   background motion vector v0 rather than snapping back to frozen unwarped a0 (eliminating shearing & lag).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D fa;
layout(binding = 1) uniform sampler2D fb;
layout(binding = 2) uniform sampler2D mv_tex;
layout(binding = 3) uniform sampler2D depth_tex;
layout(binding = 4, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P {
    float t;
    float _pad;
    vec2 uv_scale;
    vec2 uv_max;
    vec2 mv_scale;
    float depth_sign;
} pc;

float16_t gap(f16vec3 x, f16vec3 y) {
    const f16vec3 d = abs(x - y);
    return max(d.r, max(d.g, d.b));
}

vec2 sample_v(vec2 pos, vec2 inv_size) {
    const vec2 uv = clamp(pos * inv_size * pc.uv_scale, vec2(0.0), pc.uv_max);
    return -textureLod(mv_tex, uv, 0.0).xy * pc.mv_scale;
}

bool mv_consistent(vec2 v, vec2 v_chk) {
    const vec2 dv = v_chk - v;
    return dot(dv, dv) <= max(16.0, 0.16 * dot(v, v));
}

void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 d = imageSize(dst);
    if (any(greaterThanEqual(g, d))) return;
    const f16vec4 a0_4 = f16vec4(texelFetch(fa, g, 0));
    const f16vec4 b0_4 = f16vec4(texelFetch(fb, g, 0));
    if (b0_4.a < 0.5hf) {
        imageStore(dst, g, vec4(vec3(mix(a0_4.rgb, b0_4.rgb, float16_t(pc.t))), 1.0));
        return;
    }
    const float16_t moved = smoothstep(0.015hf, 0.045hf, gap(a0_4.rgb, b0_4.rgb));
    const f16vec3 still = (a0_4.a < 0.5hf) ? b0_4.rgb : mix(a0_4.rgb, b0_4.rgb, float16_t(pc.t));
    if (moved <= 0.0hf) {
        imageStore(dst, g, vec4(vec3(still), 1.0));
        return;
    }
    const f16vec3 near = (a0_4.a < 0.5hf || pc.t > 0.5) ? b0_4.rgb : a0_4.rgb;
    const f16vec3 fallback = mix(still, near, moved);
    const vec2 d_f = vec2(d);
    const vec2 p = vec2(g) + 0.5;
    const vec2 inv_size = 1.0 / d_f;
    const vec2 max_v = d_f * 0.45;
    const vec2 v0 = sample_v(p, inv_size);
    const vec2 v1 = sample_v(p + (1.0 - pc.t) * v0, inv_size);
    vec2 vm = v0;
    if (mv_consistent(v0, v1)) {
        vm = 0.5 * (v0 + v1);
    } else {
        // Silhouette boundary: test 2nd fixed-point step; accept ONLY if fa & fb actually match there!
        const vec2 v2 = sample_v(p + (1.0 - pc.t) * v1, inv_size);
        if (mv_consistent(v1, v2)) {
            const vec2 vc = 0.5 * (v1 + v2);
            if (all(lessThan(abs(vc), max_v)) && dot(vc, vc) >= 0.25) {
                const vec2 ca = (p - pc.t * vc) * inv_size;
                const vec2 cb = (p + (1.0 - pc.t) * vc) * inv_size;
                if (all(greaterThanEqual(ca, vec2(0.0))) && all(lessThanEqual(ca, vec2(1.0))) &&
                    all(greaterThanEqual(cb, vec2(0.0))) && all(lessThanEqual(cb, vec2(1.0)))) {
                    const f16vec4 a_c = f16vec4(textureLod(fa, ca, 0.0));
                    const f16vec4 b_c = f16vec4(textureLod(fb, cb, 0.0));
                    if (a_c.a > 0.98hf && b_c.a > 0.98hf && gap(a_c.rgb, b_c.rgb) < 0.22hf) {
                        imageStore(dst, g, vec4(vec3(mix(still, mix(a_c.rgb, b_c.rgb, float16_t(pc.t)), moved)), 1.0));
                        return;
                    }
                }
            }
        }
    }
    if (!all(lessThan(abs(vm), max_v)) || dot(vm, vm) < 0.25) {
        imageStore(dst, g, vec4(vec3(fallback), 1.0));
        return;
    }
    const vec2 uv_a = (p - pc.t * vm) * inv_size;
    const vec2 uv_b = (p + (1.0 - pc.t) * vm) * inv_size;
    const bool in_a = all(greaterThanEqual(uv_a, vec2(0.0))) && all(lessThanEqual(uv_a, vec2(1.0)));
    const bool in_b = all(greaterThanEqual(uv_b, vec2(0.0))) && all(lessThanEqual(uv_b, vec2(1.0)));
    if (!in_a && !in_b) {
        imageStore(dst, g, vec4(vec3(fallback), 1.0));
        return;
    }
    const f16vec4 a4 = in_a ? f16vec4(textureLod(fa, uv_a, 0.0)) : f16vec4(0.0hf);
    const f16vec4 b4 = in_b ? f16vec4(textureLod(fb, uv_b, 0.0)) : f16vec4(0.0hf);
    const bool ok_a = in_a && a4.a > 0.98hf;
    const bool ok_b = in_b && b4.a > 0.98hf;
    if (!ok_a && !ok_b) {
        imageStore(dst, g, vec4(vec3(fallback), 1.0));
        return;
    }
    f16vec3 warped;
    if (!ok_a) {
        warped = b4.rgb;
    } else if (!ok_b) {
        warped = a4.rgb;
    } else {
        const float16_t agree = 1.0hf - smoothstep(0.14hf, 0.32hf, gap(a4.rgb, b4.rgb));
        warped = mix(b4.rgb, mix(a4.rgb, b4.rgb, float16_t(pc.t)), agree);
    }
    imageStore(dst, g, vec4(vec3(mix(still, warped, moved)), 1.0));
}
