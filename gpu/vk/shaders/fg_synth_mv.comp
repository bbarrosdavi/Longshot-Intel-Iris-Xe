#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// (Batch 14) Clean, artifact-free FP16 single-output 3D Motion-Vector synthesis (2x / Auto / >3x FG).
// - Uses exact 3D camera+actor motion vectors (skipping fg_flow) where warped (fa, fb) agree cleanly and stay off HUD.
// - Checks BOTH forward (p + (1-t)*v0) and backward (p - t*v0) MV consistency so floor pixels downstream of Link never
//   sample through Link's boots/shield into cast shadows.
// - When exact pre/post-HUD alpha mask is active (depth_sign > 0), warps all consistent 3D scene pixels at full agree
//   weight so low-contrast cobblestone grout lines never wash out or double-image during camera pans.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D fa;
layout(binding = 1) uniform sampler2D fb;
layout(binding = 2) uniform sampler2D mv_tex;
layout(binding = 3) uniform sampler2D depth_tex;
layout(binding = 4, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P {
    float t;
    float _pad;
    vec2 uv_scale;
    vec2 uv_max;
    vec2 mv_scale;
    float depth_sign;
} pc;

float16_t gap(f16vec3 x, f16vec3 y) {
    const f16vec3 d = abs(x - y);
    return max(d.r, max(d.g, d.b));
}

vec2 sample_v(vec2 pos, vec2 inv_size) {
    const vec2 uv = clamp(pos * inv_size * pc.uv_scale, vec2(0.0), pc.uv_max);
    return -textureLod(mv_tex, uv, 0.0).xy * pc.mv_scale;
}

bool mv_consistent(vec2 v, vec2 v_chk) {
    const vec2 dv = v_chk - v;
    return dot(dv, dv) <= max(9.0, 0.12 * dot(v, v));
}

void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 d = imageSize(dst);
    if (any(greaterThanEqual(g, d))) return;
    const f16vec4 a0_4 = f16vec4(texelFetch(fa, g, 0));
    const f16vec4 b0_4 = f16vec4(texelFetch(fb, g, 0));
    if (b0_4.a < 0.5hf) {
        imageStore(dst, g, vec4(vec3(mix(a0_4.rgb, b0_4.rgb, float16_t(pc.t))), 1.0));
        return;
    }
    const float16_t g0 = gap(a0_4.rgb, b0_4.rgb);
    const float16_t moved = smoothstep(0.02hf, 0.07hf, g0);
    const f16vec3 still = (a0_4.a < 0.5hf) ? b0_4.rgb : mix(a0_4.rgb, b0_4.rgb, float16_t(pc.t));
    const bool exact_hud = pc.depth_sign > 0.0;
    if (!exact_hud && moved <= 0.0hf) {
        imageStore(dst, g, vec4(vec3(still), 1.0));
        return;
    }
    const f16vec3 near = (a0_4.a < 0.5hf || pc.t > 0.5) ? b0_4.rgb : a0_4.rgb;
    const f16vec3 fallback = mix(still, near, moved);
    const vec2 d_f = vec2(d);
    const vec2 p = vec2(g) + 0.5;
    const vec2 inv_size = 1.0 / d_f;
    const vec2 max_v = d_f * 0.45;
    const vec2 v0 = sample_v(p, inv_size);
    if (!all(lessThan(abs(v0), max_v)) || dot(v0, v0) < 0.25) {
        imageStore(dst, g, vec4(vec3(still), 1.0));
        return;
    }
    const vec2 v_fwd = sample_v(p + (1.0 - pc.t) * v0, inv_size);
    const vec2 v_bwd = sample_v(p - pc.t * v0, inv_size);
    if (!mv_consistent(v0, v_fwd) || !mv_consistent(v0, v_bwd)) {
        imageStore(dst, g, vec4(vec3(fallback), 1.0));
        return;
    }
    const vec2 vm = 0.5 * (v0 + v_fwd);
    const vec2 uv_a = (p - pc.t * vm) * inv_size;
    const vec2 uv_b = (p + (1.0 - pc.t) * vm) * inv_size;
    const bool in_bounds = all(greaterThanEqual(uv_a, vec2(0.0))) && all(lessThanEqual(uv_a, vec2(1.0))) &&
                           all(greaterThanEqual(uv_b, vec2(0.0))) && all(lessThanEqual(uv_b, vec2(1.0)));
    if (!in_bounds) {
        imageStore(dst, g, vec4(vec3(fallback), 1.0));
        return;
    }
    const f16vec4 a4 = f16vec4(textureLod(fa, uv_a, 0.0));
    const f16vec4 b4 = f16vec4(textureLod(fb, uv_b, 0.0));
    if (a4.a <= 0.98hf || b4.a <= 0.98hf) {
        imageStore(dst, g, vec4(vec3(fallback), 1.0));
        return;
    }
    const float16_t gw = gap(a4.rgb, b4.rgb);
    if (gw > g0 + 0.025hf && g0 < 0.08hf) {
        imageStore(dst, g, vec4(vec3(fallback), 1.0));
        return;
    }
    const float16_t agree = 1.0hf - smoothstep(0.04hf, 0.12hf, gw);
    const float16_t w = exact_hud ? agree : (moved * agree);
    imageStore(dst, g, vec4(vec3(mix(fallback, mix(a4.rgb, b4.rgb, float16_t(pc.t)), w)), 1.0));
}
