#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// (Batch 12E) Fast FP16 linear scale + RCAS pass for mode==0, side==0, !pq when upscaling or slight shrink (<=1.25x,
// e.g. 1920x1080 -> 1876x1055 tiled Wayland/Niri window). Replaces 13-tap FP32 dynamic tent loop + 81-tap side_fill
// in fg_scale.comp with 1-5 hardware bilinear fetches in FP16 (~3x faster, runs 2-3x per game frame with FrameGen).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P { float sharp; } pc;
const float16_t kMaxLobe = float16_t(0.25 - 1.0 / 16.0);

void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 d = imageSize(dst);
    if (any(greaterThanEqual(g, d))) return;
    const vec2 inv_d = 1.0 / vec2(d);
    const vec2 uv = (vec2(g) + 0.5) * inv_d;
    f16vec3 c = f16vec3(textureLod(src, uv, 0.0).rgb);
    if (pc.sharp > 0.0) {
        const vec2 e = max(1.0 / vec2(textureSize(src, 0)), inv_d);
        const f16vec3 n = f16vec3(textureLod(src, uv + vec2(0.0, -e.y), 0.0).rgb);
        const f16vec3 s = f16vec3(textureLod(src, uv + vec2(0.0, e.y), 0.0).rgb);
        const f16vec3 w = f16vec3(textureLod(src, uv + vec2(-e.x, 0.0), 0.0).rgb);
        const f16vec3 r = f16vec3(textureLod(src, uv + vec2(e.x, 0.0), 0.0).rgb);
        const f16vec3 lo4 = min(min(n, s), min(w, r));
        const f16vec3 hi4 = max(max(n, s), max(w, r));
        const f16vec3 lo = min(lo4, c);
        const f16vec3 hi = max(hi4, c);
        const f16vec3 to_black = lo / max(float16_t(4.0) * hi, f16vec3(1.0hf / 1024.0hf));
        const f16vec3 to_white = (f16vec3(1.0hf) - hi) / max(f16vec3(4.0hf) - float16_t(4.0) * lo4, f16vec3(1.0hf / 1024.0hf));
        const f16vec3 room = min(to_black, to_white);
        const float16_t lobe = -clamp(min(min(room.r, room.g), room.b), 0.0hf, kMaxLobe) * float16_t(clamp(pc.sharp, 0.0, 1.0));
        c = clamp((c + lobe * (n + s + w + r)) / (1.0hf + float16_t(4.0) * lobe), lo, hi);
    }
    imageStore(dst, g, vec4(vec3(c), 1.0));
}
