#version 450
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// (Batch 12D) FP16-accelerated fused dual-output 3D Motion-Vector synthesis (3x FG: t0=1/3 and t1=2/3 in one pass).
// - Skips reading fa(g) on moving 3D world pixels (-8.3 MB/frame BW on 95% fast path).
// - Parallax-ahead foreground NPC rescue on rare err > 0.16 pixels + color-match-first rule in eval_edge:
//   preserves walking foreground NPCs/heads 100% solid during 90+ px/f pans while keeping HUD & cliff edges razor-clean.
// - [[dont_unroll]] 2-pass edge loop keeps GRF pressure low for Gen12 SIMD16 execution.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D fa;
layout(binding = 1) uniform sampler2D fb;
layout(binding = 2) uniform sampler2D mv_tex;
layout(binding = 3) uniform sampler2D depth_tex;
layout(binding = 4, rgba8) uniform writeonly image2D dst0;
layout(binding = 5, rgba8) uniform writeonly image2D dst1;
layout(push_constant) uniform P {
    float t0;
    float t1;
    vec2 uv_scale;
    vec2 uv_max;
    vec2 mv_scale;
    float depth_sign;   // +1.0 normal depth (larger=farther), -1.0 reversed depth (smaller=farther)
} pc;

float16_t gap(f16vec3 x, f16vec3 y) {
    const f16vec3 d = abs(x - y);
    return max(d.r, max(d.g, d.b));
}

vec2 sample_v(vec2 pos, vec2 inv_size) {
    const vec2 uv = clamp(pos * inv_size * pc.uv_scale, vec2(0.0), pc.uv_max);
    return -textureLod(mv_tex, uv, 0.0).xy * pc.mv_scale;
}

float sample_far_depth(vec2 pos, vec2 inv_size) {
    const vec2 uv = clamp(pos * inv_size * pc.uv_scale, vec2(0.0), pc.uv_max);
    return textureLod(depth_tex, uv, 0.0).r * pc.depth_sign;
}

bool mv_consistent(vec2 v, vec2 v_chk) {
    const vec2 dv = v_chk - v;
    return dot(dv, dv) <= max(4.0, 0.025 * dot(v, v));
}

f16vec3 eval_smooth(ivec2 g, vec2 p, vec2 inv_size, vec2 max_v, f16vec4 b0_4, float t, vec2 vm, vec2 v0, bool check_mid) {
    const vec2 uv_a = (p - t * vm) * inv_size;
    const vec2 uv_b = (p + (1.0 - t) * vm) * inv_size;
    bool in_a = all(greaterThanEqual(uv_a, vec2(0.0))) && all(lessThanEqual(uv_a, vec2(1.0)));
    bool in_b = all(greaterThanEqual(uv_b, vec2(0.0))) && all(lessThanEqual(uv_b, vec2(1.0)));
    const f16vec4 a4 = f16vec4(textureLod(fa, clamp(uv_a, vec2(0.0), vec2(1.0)), 0.0));
    const f16vec4 b4 = f16vec4(textureLod(fb, clamp(uv_b, vec2(0.0), vec2(1.0)), 0.0));
    in_a = in_a && (a4.a > 0.98hf);
    in_b = in_b && (b4.a > 0.98hf);
    if (in_a && in_b) {
        const float16_t err = gap(a4.rgb, b4.rgb);
        if (err > 0.16hf) {
            // Rare mismatch inside smooth background field: probe parallax-ahead along vm (1.35x) to rescue
            // nearer foreground NPCs/heads moving faster than background during fast camera pans!
            const vec2 v_fg = sample_v(p + (1.0 - t) * vm * 1.35, inv_size);
            if (all(lessThan(abs(v_fg), max_v)) && dot(v_fg - vm, v_fg - vm) > 9.0) {
                const vec2 uaf = (p - t * v_fg) * inv_size;
                const vec2 ubf = (p + (1.0 - t) * v_fg) * inv_size;
                bool iaf = all(greaterThanEqual(uaf, vec2(0.0))) && all(lessThanEqual(uaf, vec2(1.0)));
                bool ibf = all(greaterThanEqual(ubf, vec2(0.0))) && all(lessThanEqual(ubf, vec2(1.0)));
                const f16vec4 af4 = f16vec4(textureLod(fa, clamp(uaf, vec2(0.0), vec2(1.0)), 0.0));
                const f16vec4 bf4 = f16vec4(textureLod(fb, clamp(ubf, vec2(0.0), vec2(1.0)), 0.0));
                iaf = iaf && (af4.a > 0.98hf);
                ibf = ibf && (bf4.a > 0.98hf);
                if (iaf && ibf) {
                    const float16_t errf = gap(af4.rgb, bf4.rgb);
                    if (errf < 0.26hf && errf + 0.04hf < err) {
                        return mix(af4.rgb, bf4.rgb, float16_t(t));
                    }
                }
            }
        }
        if (err > 0.08hf) {
            const float16_t agree = 1.0hf - smoothstep(0.08hf, 0.22hf, err);
            f16vec3 solo = b4.rgb;
            if (check_mid && err > 0.16hf) {
                const vec2 v_chk = sample_v(p + (1.0 - t) * vm, inv_size);
                if (!mv_consistent(v0, v_chk)) solo = a4.rgb;
            }
            return mix(solo, mix(a4.rgb, b4.rgb, float16_t(t)), agree);
        }
        return mix(a4.rgb, b4.rgb, float16_t(t));
    }
    if (in_b) return b4.rgb;
    if (in_a) return a4.rgb;
    const f16vec4 a0_4 = f16vec4(texelFetch(fa, g, 0));
    return (a0_4.a < 0.5hf || t > 0.5) ? b0_4.rgb : a0_4.rgb;
}

f16vec3 eval_edge(vec2 p, vec2 inv_size, vec2 max_v, f16vec4 a0_4, f16vec4 b0_4, float16_t moved, float t,
                  vec2 v0, float v0_sq, bool ok0, vec2 v_dil) {
    vec2 v1;
    if (v0_sq < 4.0) {
        v1 = v_dil;
        if (dot(v1, v1) >= 4.0) {
            const vec2 v1r = sample_v(p + (1.0 - t) * v1, inv_size);
            if (dot(v1r, v1r) >= 4.0) v1 = v1r;
        }
    } else {
        v1 = sample_v(p + (1.0 - t) * v0, inv_size);
    }
    const bool ok1 = all(lessThan(abs(v1), max_v));

    const vec2 bv0 = ok0 ? v0 : vec2(0.0);
    const vec2 uv_a0 = (p - t * bv0) * inv_size;
    const vec2 uv_b0 = (p + (1.0 - t) * bv0) * inv_size;
    bool in_a0 = all(greaterThanEqual(uv_a0, vec2(0.0))) && all(lessThanEqual(uv_a0, vec2(1.0)));
    bool in_b0 = all(greaterThanEqual(uv_b0, vec2(0.0))) && all(lessThanEqual(uv_b0, vec2(1.0)));
    const f16vec4 a0_s = f16vec4(textureLod(fa, clamp(uv_a0, vec2(0.0), vec2(1.0)), 0.0));
    const f16vec4 b0_s = f16vec4(textureLod(fb, clamp(uv_b0, vec2(0.0), vec2(1.0)), 0.0));
    in_a0 = in_a0 && (a0_s.a > 0.98hf);
    in_b0 = in_b0 && (b0_s.a > 0.98hf);
    const float16_t err0 = (in_a0 && in_b0) ? gap(a0_s.rgb, b0_s.rgb) : ((in_a0 || in_b0) ? 0.16hf : 1.0hf);
    const bool cons0 = ok0 && in_b0 && ((v0_sq < 4.0) ? true : mv_consistent(v0, v1));
    const bool match0 = in_a0 && in_b0 && (err0 < 0.28hf);

    bool have1 = false, in_a1 = false, in_b1 = false, cons1 = false, match1 = false;
    f16vec3 a1_rgb = f16vec3(0.0hf), b1_rgb = f16vec3(0.0hf);
    float16_t err1 = 1.0hf;
    if (ok1 && dot(v1 - bv0, v1 - bv0) > 4.0 && !(cons0 && err0 < 0.06hf)) {
        have1 = true;
        const vec2 uv_a1 = (p - t * v1) * inv_size;
        const vec2 uv_b1 = (p + (1.0 - t) * v1) * inv_size;
        in_a1 = all(greaterThanEqual(uv_a1, vec2(0.0))) && all(lessThanEqual(uv_a1, vec2(1.0)));
        in_b1 = all(greaterThanEqual(uv_b1, vec2(0.0))) && all(lessThanEqual(uv_b1, vec2(1.0)));
        const f16vec4 a1_s = f16vec4(textureLod(fa, clamp(uv_a1, vec2(0.0), vec2(1.0)), 0.0));
        const f16vec4 b1_s = f16vec4(textureLod(fb, clamp(uv_b1, vec2(0.0), vec2(1.0)), 0.0));
        in_a1 = in_a1 && (a1_s.a > 0.98hf);
        in_b1 = in_b1 && (b1_s.a > 0.98hf);
        a1_rgb = a1_s.rgb;
        b1_rgb = b1_s.rgb;
        err1 = (in_a1 && in_b1) ? gap(a1_rgb, b1_rgb) : ((in_a1 || in_b1) ? 0.16hf : 1.0hf);
        const vec2 v_chk1 = sample_v(p + (1.0 - t) * v1, inv_size);
        cons1 = in_b1 && mv_consistent(v1, v_chk1);
        match1 = in_a1 && in_b1 && (err1 < 0.28hf);
    }

    bool use1 = false;
    bool prefer_a = false;
    if (match0 || match1) {
        const float16_t s0 = err0 + (cons0 ? 0.0hf : 0.06hf);
        const float16_t s1 = err1 + (cons1 ? 0.0hf : 0.06hf);
        use1 = match1 && (!match0 || s1 + 0.01hf < s0);
        prefer_a = !(use1 ? cons1 : cons0);
    } else {
        if (have1 && v0_sq >= 4.0) {
            const float d0 = sample_far_depth(p, inv_size);
            const float d1 = sample_far_depth(p + (1.0 - t) * bv0, inv_size);
            if (abs(d1 - d0) > 1e-4) {
                use1 = (d1 > d0) && !cons0;
            } else {
                use1 = err1 + 0.02hf < err0;
            }
        }
        prefer_a = !(use1 ? cons1 : cons0);
    }

    const bool in_a = use1 ? in_a1 : in_a0;
    const bool in_b = use1 ? in_b1 : in_b0;
    const f16vec3 a = use1 ? a1_rgb : a0_s.rgb;
    const f16vec3 b = use1 ? b1_rgb : b0_s.rgb;
    const float16_t err = use1 ? err1 : err0;

    f16vec3 warped;
    if (in_a && in_b) {
        const float16_t agree = 1.0hf - smoothstep(0.10hf, 0.28hf, err);
        warped = mix(prefer_a ? a : b, mix(a, b, float16_t(t)), agree);
    } else if (prefer_a && in_a) {
        warped = a;
    } else if (in_b) {
        warped = b;
    } else if (in_a) {
        warped = a;
    } else {
        warped = (a0_4.a < 0.5hf || t > 0.5) ? b0_4.rgb : a0_4.rgb;
    }
    const f16vec3 still = (a0_4.a < 0.5hf) ? b0_4.rgb : mix(a0_4.rgb, b0_4.rgb, float16_t(t));
    return mix(still, warped, moved);
}

void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 d = imageSize(dst0);
    if (any(greaterThanEqual(g, d))) return;
    const f16vec4 b0_4 = f16vec4(texelFetch(fb, g, 0));
    if (b0_4.a < 0.5hf) {
        const f16vec3 a0 = f16vec3(texelFetch(fa, g, 0).rgb);
        imageStore(dst0, g, vec4(vec3(mix(a0, b0_4.rgb, float16_t(pc.t0))), 1.0));
        imageStore(dst1, g, vec4(vec3(mix(a0, b0_4.rgb, float16_t(pc.t1))), 1.0));
        return;
    }
    const vec2 d_f = vec2(d);
    const vec2 p = vec2(g) + 0.5;
    const vec2 inv_size = 1.0 / d_f;
    const vec2 max_v = d_f * 0.45;
    const vec2 v0 = sample_v(p, inv_size);
    const float v0_sq = dot(v0, v0);
    const bool ok0 = all(lessThan(abs(v0), max_v));

    if (ok0 && v0_sq >= 4.0) {
        const vec2 v_far = sample_v(p + (1.0 - pc.t0) * v0, inv_size);
        if (mv_consistent(v0, v_far)) {
            const vec2 vm = 0.5 * (v0 + v_far);
            imageStore(dst0, g, vec4(vec3(eval_smooth(g, p, inv_size, max_v, b0_4, pc.t0, vm, v0, false)), 1.0));
            imageStore(dst1, g, vec4(vec3(eval_smooth(g, p, inv_size, max_v, b0_4, pc.t1, vm, v0, true)), 1.0));
            return;
        }
    }
    const f16vec4 a0_4 = f16vec4(texelFetch(fa, g, 0));
    const float16_t moved = smoothstep(0.03hf, 0.09hf, gap(a0_4.rgb, b0_4.rgb));
    if (moved <= 0.0hf) {
        imageStore(dst0, g, vec4(vec3(mix(a0_4.rgb, b0_4.rgb, float16_t(pc.t0))), 1.0));
        imageStore(dst1, g, vec4(vec3(mix(a0_4.rgb, b0_4.rgb, float16_t(pc.t1))), 1.0));
        return;
    }
    vec2 v_dil = v0;
    if (v0_sq < 4.0) {
        float best_d2 = v0_sq;
        vec2 dir = vec2(1.0, 0.0);
        [[dont_unroll]] for (int i = 0; i < 4; i++) {
            const vec2 n1 = sample_v(p + dir * 8.0, inv_size);
            const float d1 = dot(n1, n1);
            if (d1 > best_d2) best_d2 = d1, v_dil = n1;
            const vec2 n2 = sample_v(p + dir * 20.0, inv_size);
            const float d2 = dot(n2, n2);
            if (d2 > best_d2) best_d2 = d2, v_dil = n2;
            dir = vec2(-dir.y, dir.x);
        }
    }
    [[dont_unroll]] for (int pass = 0; pass < 2; pass++) {
        const float t = (pass == 0) ? pc.t0 : pc.t1;
        const f16vec3 c = eval_edge(p, inv_size, max_v, a0_4, b0_4, moved, t, v0, v0_sq, ok0, v_dil);
        if (pass == 0) imageStore(dst0, g, vec4(vec3(c), 1.0));
        else imageStore(dst1, g, vec4(vec3(c), 1.0));
    }
}
