#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// (Batch 13) Clean, artifact-free FP16 fused dual-output 3D Motion-Vector synthesis (3x FG: t0=1/3 and t1=2/3 in one pass).
// - Uses exact 3D camera+actor motion vectors (skipping fg_flow) where warped (fa, fb) agree cleanly and stay off HUD.
// - On unmatchable pixels (animated limbs, shadows, water splashes, moving speech bubbles, disocclusion seams), smoothly
//   falls back to unwarped near=(t<=0.5?a0:b0), matching fg_synth2.comp's zero-speckle, zero-hole, zero-flicker guarantee.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D fa;
layout(binding = 1) uniform sampler2D fb;
layout(binding = 2) uniform sampler2D mv_tex;
layout(binding = 3) uniform sampler2D depth_tex;
layout(binding = 4, rgba8) uniform writeonly image2D dst0;
layout(binding = 5, rgba8) uniform writeonly image2D dst1;
layout(push_constant) uniform P {
    float t0;
    float t1;
    vec2 uv_scale;
    vec2 uv_max;
    vec2 mv_scale;
    float depth_sign;
} pc;

float16_t gap(f16vec3 x, f16vec3 y) {
    const f16vec3 d = abs(x - y);
    return max(d.r, max(d.g, d.b));
}

vec2 sample_v(vec2 pos, vec2 inv_size) {
    const vec2 uv = clamp(pos * inv_size * pc.uv_scale, vec2(0.0), pc.uv_max);
    return -textureLod(mv_tex, uv, 0.0).xy * pc.mv_scale;
}

bool mv_consistent(vec2 v, vec2 v_chk) {
    const vec2 dv = v_chk - v;
    return dot(dv, dv) <= max(9.0, 0.12 * dot(v, v));
}

f16vec3 synth_t(vec2 p, vec2 inv_size, f16vec4 a0_4, f16vec4 b0_4, float16_t moved, vec2 v0, bool ok0, float t) {
    const f16vec3 still = (a0_4.a < 0.5hf) ? b0_4.rgb : mix(a0_4.rgb, b0_4.rgb, float16_t(t));
    const f16vec3 near = (a0_4.a < 0.5hf || t > 0.5) ? b0_4.rgb : a0_4.rgb;
    const f16vec3 fallback = mix(still, near, moved);
    if (!ok0) return fallback;
    const vec2 v_mid = sample_v(p + (1.0 - t) * v0, inv_size);
    if (!mv_consistent(v0, v_mid)) return fallback;
    const vec2 vm = 0.5 * (v0 + v_mid);
    const vec2 uv_a = (p - t * vm) * inv_size;
    const vec2 uv_b = (p + (1.0 - t) * vm) * inv_size;
    const bool in_bounds = all(greaterThanEqual(uv_a, vec2(0.0))) && all(lessThanEqual(uv_a, vec2(1.0))) &&
                           all(greaterThanEqual(uv_b, vec2(0.0))) && all(lessThanEqual(uv_b, vec2(1.0)));
    if (!in_bounds) return fallback;
    const f16vec4 a4 = f16vec4(textureLod(fa, uv_a, 0.0));
    const f16vec4 b4 = f16vec4(textureLod(fb, uv_b, 0.0));
    if (a4.a <= 0.98hf || b4.a <= 0.98hf) return fallback;
    const float16_t agree = 1.0hf - smoothstep(0.06hf, 0.22hf, gap(a4.rgb, b4.rgb));
    return mix(fallback, mix(a4.rgb, b4.rgb, float16_t(t)), moved * agree);
}

void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 d = imageSize(dst0);
    if (any(greaterThanEqual(g, d))) return;
    const f16vec4 a0_4 = f16vec4(texelFetch(fa, g, 0));
    const f16vec4 b0_4 = f16vec4(texelFetch(fb, g, 0));
    if (b0_4.a < 0.5hf) {
        imageStore(dst0, g, vec4(vec3(mix(a0_4.rgb, b0_4.rgb, float16_t(pc.t0))), 1.0));
        imageStore(dst1, g, vec4(vec3(mix(a0_4.rgb, b0_4.rgb, float16_t(pc.t1))), 1.0));
        return;
    }
    const float16_t moved = smoothstep(0.03hf, 0.09hf, gap(a0_4.rgb, b0_4.rgb));
    if (moved <= 0.0hf) {
        const f16vec3 c0 = (a0_4.a < 0.5hf) ? b0_4.rgb : mix(a0_4.rgb, b0_4.rgb, float16_t(pc.t0));
        const f16vec3 c1 = (a0_4.a < 0.5hf) ? b0_4.rgb : mix(a0_4.rgb, b0_4.rgb, float16_t(pc.t1));
        imageStore(dst0, g, vec4(vec3(c0), 1.0));
        imageStore(dst1, g, vec4(vec3(c1), 1.0));
        return;
    }
    const vec2 d_f = vec2(d);
    const vec2 p = vec2(g) + 0.5;
    const vec2 inv_size = 1.0 / d_f;
    const vec2 max_v = d_f * 0.45;
    const vec2 v0 = sample_v(p, inv_size);
    const bool ok0 = all(lessThan(abs(v0), max_v)) && dot(v0, v0) >= 0.25;
    imageStore(dst0, g, vec4(vec3(synth_t(p, inv_size, a0_4, b0_4, moved, v0, ok0, pc.t0)), 1.0));
    imageStore(dst1, g, vec4(vec3(synth_t(p, inv_size, a0_4, b0_4, moved, v0, ok0, pc.t1)), 1.0));
}
